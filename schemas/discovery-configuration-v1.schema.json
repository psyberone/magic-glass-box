{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magic-glass-box.local/schemas/discovery-configuration-v1.schema.json",
  "title": "Magic Glass Box Discovery configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "max_findings",
    "max_must_items",
    "max_follow_up_proposals"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "max_findings": {"type": "integer", "minimum": 1, "maximum": 32},
    "max_must_items": {"type": "integer", "minimum": 1, "maximum": 5},
    "max_follow_up_proposals": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    }
  }
}

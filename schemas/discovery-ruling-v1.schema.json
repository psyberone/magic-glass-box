{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magic-glass-box.local/schemas/discovery-ruling-v1.schema.json",
  "title": "Magic Glass Box Discovery ruling v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "disposition",
    "summary",
    "trace_finding_keys",
    "interaction_id",
    "work_ready_brief"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "disposition": {"enum": ["GO", "NO_GO", "ASK_HUMAN"]},
    "summary": {"$ref": "#/$defs/text4096"},
    "trace_finding_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/key"}
    },
    "interaction_id": {
      "type": ["string", "null"],
      "pattern": "^int_[0-9a-f]{32}$"
    },
    "work_ready_brief": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/workReadyBrief"}]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "GO"}}},
      "then": {"properties": {"work_ready_brief": {"$ref": "#/$defs/workReadyBrief"}}},
      "else": {"properties": {"work_ready_brief": {"type": "null"}}}
    },
    {
      "if": {"properties": {"disposition": {"const": "ASK_HUMAN"}}},
      "then": {
        "properties": {
          "interaction_id": {"type": "string", "pattern": "^int_[0-9a-f]{32}$"}
        }
      }
    }
  ],
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "text2048": {"type": "string", "minLength": 1, "maxLength": 2048},
    "text4096": {"type": "string", "minLength": 1, "maxLength": 4096},
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "index"],
      "properties": {
        "kind": {"enum": ["brief", "acceptance_criterion"]},
        "index": {"type": ["integer", "null"], "minimum": 0, "maximum": 127}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "brief"}}},
          "then": {"properties": {"index": {"type": "null"}}},
          "else": {"properties": {"index": {"type": "integer"}}}
        }
      ]
    },
    "mustItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "requirement", "source_refs", "finding_keys"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "requirement": {"$ref": "#/$defs/text4096"},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceRef"}
        },
        "finding_keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/key"}
        }
      }
    },
    "workReadyBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "must_items",
        "scope_paths",
        "verification_checks",
        "non_goals",
        "follow_up_proposals"
      ],
      "properties": {
        "objective": {"type": "string", "minLength": 1, "maxLength": 8192},
        "must_items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/mustItem"}
        },
        "scope_paths": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        },
        "verification_checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text2048"}
        },
        "non_goals": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text2048"}
        },
        "follow_up_proposals": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text4096"}
        }
      }
    }
  }
}

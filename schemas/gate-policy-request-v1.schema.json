{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magic-glass-box:schema:gate-policy-request:v1",
  "title": "Magic Glass Box Gate Policy Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_separation", "schema_version", "validations"],
  "properties": {
    "review_separation": {
      "type": ["string", "null"],
      "enum": [
        "different_profile",
        "different_identity",
        "different_profile_and_identity",
        null
      ]
    },
    "schema_version": { "const": 1 },
    "validations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "image", "name"],
        "properties": {
          "command": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "image": { "type": "string", "minLength": 1, "maxLength": 512 },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "review_separation": { "type": "string" }
      },
      "required": ["review_separation"]
    },
    {
      "properties": {
        "validations": { "minItems": 1 }
      },
      "required": ["validations"]
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magic-glass-box:schema:change-open-readback:v2",
  "title": "Magic Glass Box Change Open Readback v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_ref", "base_revision", "body", "change_id", "closure_references",
    "draft", "head_ref", "head_revision", "schema_version",
    "secondary_effects", "state", "title"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "change_id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "base_ref": { "$ref": "#/$defs/branchRef" },
    "head_ref": { "$ref": "#/$defs/branchRef" },
    "base_revision": { "$ref": "#/$defs/objectId" },
    "head_revision": { "$ref": "#/$defs/objectId" },
    "title": { "type": "string", "minLength": 1, "maxLength": 512 },
    "body": { "type": "string", "maxLength": 32768 },
    "draft": { "type": "boolean" },
    "state": { "enum": ["open", "closed"] },
    "closure_references": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": { "$ref": "#/$defs/remoteReference" }
    },
    "secondary_effects": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": { "$ref": "#/$defs/secondaryEffect" }
    }
  },
  "$defs": {
    "branchRef": { "type": "string", "minLength": 12, "maxLength": 256, "pattern": "^refs/heads/(?!@$)(?![/.])(?!.*/\\.)(?!.*(?:\\.\\.|@\\{|//|\\.lock(?:/|$)))(?!.*[/.]$)[^ ~^:?*\\\\[\\u0000-\\u001f\\u007f]+$" },
    "objectId": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "remoteReference": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,31}:[^\\s]{1,223}$" },
    "secondaryEffect": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,31}:[^\\s]{1,223}$" }
  }
}

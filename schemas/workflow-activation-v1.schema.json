{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magic-glass-box:schema:workflow-activation:v1",
  "title": "Magic Glass Box Project Workflow Activation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_bindings",
    "merge_method",
    "policy_sha256",
    "resources",
    "retired_rules",
    "schema_version",
    "validation_bindings",
    "wake_bindings",
    "workflow_configuration_version_id"
  ],
  "properties": {
    "capability_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capabilityBinding" }
    },
    "merge_method": { "enum": ["merge", "rebase", "squash"] },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resources": { "$ref": "#/$defs/resources" },
    "retired_rules": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,127}$"
      }
    },
    "schema_version": { "const": 1 },
    "validation_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/validationBinding" }
    },
    "wake_bindings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/wakeBinding" }
    },
    "workflow_configuration_version_id": {
      "type": "string",
      "pattern": "^wfv_[0-9a-f]{32}$"
    }
  },
  "$defs": {
    "capabilityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "mode", "name", "version"],
      "properties": {
        "binding_id": {
          "type": "string",
          "pattern": "^cpb_[0-9a-f]{32}$"
        },
        "mode": { "enum": ["effect", "read"] },
        "name": {
          "enum": [
            "change.get",
            "change.list",
            "change.open",
            "checks.read",
            "execution.cancel",
            "execution.collect",
            "execution.inspect",
            "execution.submit",
            "landing.invoke",
            "refs.publish",
            "work.get",
            "work.list",
            "work.state"
          ]
        },
        "version": { "const": 1 }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_rounds",
        "seat_count",
        "shared_host_concurrency",
        "wall_time_seconds"
      ],
      "properties": {
        "review_rounds": { "type": "integer", "minimum": 1, "maximum": 8 },
        "seat_count": { "type": "integer", "minimum": 1, "maximum": 16 },
        "shared_host_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "wall_time_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 604800
        }
      }
    },
    "validationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation", "validation"],
      "properties": {
        "obligation": { "$ref": "#/$defs/name" },
        "validation": { "$ref": "#/$defs/name" }
      }
    },
    "wakeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "wake_class"],
      "properties": {
        "role": { "enum": ["producer", "reviewer"] },
        "wake_class": { "const": "human_turn_only" }
      }
    }
  }
}

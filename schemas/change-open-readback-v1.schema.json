{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magic-glass-box:schema:change-open-readback:v1",
  "title": "Magic Glass Box Change Open Readback v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_ref", "base_revision", "body", "change_id", "draft", "head_ref",
    "head_revision", "schema_version", "secondary_effects", "state", "title"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "change_id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "base_ref": { "$ref": "#/$defs/branchRef" },
    "head_ref": { "$ref": "#/$defs/branchRef" },
    "base_revision": { "$ref": "#/$defs/objectId" },
    "head_revision": { "$ref": "#/$defs/objectId" },
    "title": { "type": "string", "minLength": 1, "maxLength": 512 },
    "body": { "type": "string", "maxLength": 32768 },
    "draft": { "type": "boolean" },
    "state": { "enum": ["open", "closed"] },
    "secondary_effects": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "branchRef": { "type": "string", "minLength": 12, "maxLength": 256, "pattern": "^refs/heads/(?!@$)(?![/.])(?!.*/\\.)(?!.*(?:\\.\\.|@\\{|//|\\.lock(?:/|$)))(?!.*[/.]$)[^ ~^:?*\\\\[\\u0000-\\u001f\\u007f]+$" },
    "objectId": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magic-glass-box:schema:work-item:v1",
  "title": "Magic Glass Box Work Item v1",
  "description": "Forge-neutral, untrusted assignment content for atomic import.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "external_id",
    "source_updated_at",
    "title",
    "brief"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "external_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "source_updated_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64,
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "brief": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "\\S"
    },
    "acceptance_criteria": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "\\S"
      },
      "default": []
    },
    "constraints": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "\\S"
      },
      "default": []
    },
    "context": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {
              "type": { "const": "note" },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "pattern": "\\S"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {
              "type": { "const": "workspace_path" },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "allOf": [
                  {"pattern": "\\S"},
                  {"pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*/$).+$"}
                ]
              }
            }
          }
        ]
      },
      "default": []
    },
    "labels": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "\\S"
      },
      "default": []
    },
    "priority": {
      "enum": ["low", "normal", "high", "urgent"],
      "default": "normal"
    }
  }
}

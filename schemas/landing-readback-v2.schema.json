{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magic-glass-box:schema:landing-readback:v2",
  "title": "Magic Glass Box Landing Readback v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_ref", "body", "candidate_revision", "change_id",
    "closure_references", "draft", "first_parent_status", "head_ref",
    "landing_commit_message", "landing_parent_revisions", "landing_revision",
    "landing_tree", "primary_ref", "primary_revision", "schema_version",
    "secondary_effects", "state", "title"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "change_id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "base_ref": { "$ref": "#/$defs/branchRef" },
    "head_ref": { "$ref": "#/$defs/branchRef" },
    "candidate_revision": { "$ref": "#/$defs/objectId" },
    "landing_revision": { "$ref": "#/$defs/objectId" },
    "landing_tree": { "$ref": "#/$defs/objectId" },
    "landing_parent_revisions": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": { "$ref": "#/$defs/objectId" }
    },
    "landing_commit_message": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "primary_ref": { "$ref": "#/$defs/branchRef" },
    "primary_revision": { "$ref": "#/$defs/objectId" },
    "first_parent_status": { "enum": ["contains", "absent", "truncated"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 512 },
    "body": { "type": "string", "maxLength": 32768 },
    "draft": { "type": "boolean" },
    "state": { "const": "closed" },
    "closure_references": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": { "$ref": "#/$defs/remoteReference" }
    },
    "secondary_effects": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": { "$ref": "#/$defs/secondaryEffect" }
    }
  },
  "$defs": {
    "branchRef": { "type": "string", "minLength": 12, "maxLength": 256, "pattern": "^refs/heads/(?!@$)(?![/.])(?!.*/\\.)(?!.*(?:\\.\\.|@\\{|//|\\.lock(?:/|$)))(?!.*[/.]$)[^ ~^:?*\\\\[\\u0000-\\u001f\\u007f]+$" },
    "objectId": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "remoteReference": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,31}:[^\\s]{1,223}$" },
    "secondaryEffect": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,31}:[^\\s]{1,223}$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magic-glass-box:schema:workflow-policy:v1",
  "title": "Magic Glass Box Portable Implementation Workflow Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allow_deferred_validation",
    "evidence_floor",
    "landing_methods",
    "prescription",
    "required_capabilities",
    "resource_maxima",
    "schema_version",
    "validation_obligations",
    "wake_mode"
  ],
  "properties": {
    "allow_deferred_validation": { "type": "boolean" },
    "evidence_floor": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "maintainer_disposition",
          "reviewed_content",
          "validated_execution"
        ]
      }
    },
    "landing_methods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["merge", "rebase", "squash"] }
    },
    "prescription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "revision"],
      "properties": {
        "key": { "const": "implementation-v1" },
        "revision": {
          "const": "b165a0973686c2e87ed8b4150e919e88f826b8558fe560eafcb256a87b5d75ff"
        }
      }
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "resource_maxima": { "$ref": "#/$defs/resources" },
    "schema_version": { "const": 1 },
    "validation_obligations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    },
    "wake_mode": { "const": "manual" }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "name", "version"],
      "properties": {
        "mode": { "enum": ["effect", "read"] },
        "name": {
          "enum": [
            "change.get",
            "change.list",
            "change.open",
            "checks.read",
            "execution.cancel",
            "execution.collect",
            "execution.inspect",
            "execution.submit",
            "landing.invoke",
            "refs.publish",
            "work.get",
            "work.list",
            "work.state"
          ]
        },
        "version": { "const": 1 }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_rounds",
        "seat_count",
        "shared_host_concurrency",
        "wall_time_seconds"
      ],
      "properties": {
        "review_rounds": { "type": "integer", "minimum": 1, "maximum": 8 },
        "seat_count": { "type": "integer", "minimum": 1, "maximum": 16 },
        "shared_host_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "wall_time_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 604800
        }
      }
    }
  }
}

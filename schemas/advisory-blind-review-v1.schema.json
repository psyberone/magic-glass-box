{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magic-glass-box.local/schemas/advisory-blind-review-v1.schema.json",
  "title": "Magic Glass Box advisory blind review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "summary", "risk_level", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "summary": {"$ref": "#/$defs/text4096"},
    "risk_level": {"enum": ["none", "low", "moderate", "high", "critical"]},
    "findings": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"risk_level": {"const": "none"}}},
      "then": {"properties": {"findings": {"maxItems": 0}}},
      "else": {"properties": {"findings": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
    "text2048": {"type": "string", "minLength": 1, "maxLength": 2048},
    "text4096": {"type": "string", "minLength": 1, "maxLength": 4096},
    "text8192": {"type": "string", "minLength": 1, "maxLength": 8192},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_end", "summary"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "line_start": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "line_end": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "summary": {"$ref": "#/$defs/text2048"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "category",
        "severity",
        "summary",
        "rationale",
        "evidence",
        "suggested_check"
      ],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "category": {
          "enum": [
            "correctness",
            "security",
            "reliability",
            "performance",
            "maintainability",
            "testing",
            "documentation",
            "product_fit"
          ]
        },
        "severity": {"enum": ["critical", "major", "minor", "note"]},
        "summary": {"$ref": "#/$defs/text4096"},
        "rationale": {"$ref": "#/$defs/text8192"},
        "evidence": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "suggested_check": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/text4096"}]
        }
      }
    }
  }
}

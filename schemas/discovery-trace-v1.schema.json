{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magic-glass-box.local/schemas/discovery-trace-v1.schema.json",
  "title": "Magic Glass Box Discovery trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "summary",
    "findings",
    "recommended_checks",
    "open_questions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "summary": {"$ref": "#/$defs/text4096"},
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/finding"}
    },
    "recommended_checks": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text2048"}
    },
    "open_questions": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text2048"}
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "text2048": {"type": "string", "minLength": 1, "maxLength": 2048},
    "text4096": {"type": "string", "minLength": 1, "maxLength": 4096},
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "index"],
      "properties": {
        "kind": {"enum": ["brief", "acceptance_criterion"]},
        "index": {"type": ["integer", "null"], "minimum": 0, "maximum": 127}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "brief"}}},
          "then": {"properties": {"index": {"type": "null"}}},
          "else": {"properties": {"index": {"type": "integer"}}}
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_end", "summary"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "line_start": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "line_end": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "summary": {"$ref": "#/$defs/text2048"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "classification",
        "summary",
        "source_refs",
        "evidence"
      ],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "classification": {
          "enum": ["requirement", "constraint", "risk", "unknown"]
        },
        "summary": {"$ref": "#/$defs/text4096"},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceRef"}
        },
        "evidence": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magic-glass-box:schema:gate-policy:v1",
  "title": "Magic Glass Box Exact-Input Gate Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "context_version_id",
    "expected_base_revision",
    "head_revision",
    "integration_ref",
    "object_format",
    "policy",
    "policy_revision",
    "project_id",
    "repository_identity",
    "schema_version",
    "tree_revision",
    "work_thread_id"
  ],
  "properties": {
    "candidate_id": { "type": "string", "pattern": "^cnd_[0-9a-f]{32}$" },
    "context_version_id": {
      "type": "string",
      "pattern": "^ctx_[0-9a-f]{32}$"
    },
    "expected_base_revision": { "$ref": "#/$defs/objectId" },
    "head_revision": { "$ref": "#/$defs/objectId" },
    "integration_ref": {
      "type": "string",
      "pattern": "^refs/heads/(?!@$)(?!\\.)(?!.*\\/\\.)(?!.*(?:\\.\\.|@\\{|//|\\.lock(?:/|$)))(?!.*[/.]$)[^ ~^:?*\\\\[\\u0000-\\u001f\\u007f]+$",
      "maxLength": 512
    },
    "object_format": { "enum": ["sha1", "sha256"] },
    "policy": { "$ref": "#/$defs/policy" },
    "policy_revision": { "$ref": "#/$defs/sha256" },
    "project_id": {
      "type": "string",
      "pattern": "^boxp_[0-9a-f]{32}$"
    },
    "repository_identity": {
      "type": "string",
      "pattern": "^boxp_[0-9a-f]{32}$"
    },
    "schema_version": { "const": 1 },
    "tree_revision": { "$ref": "#/$defs/objectId" },
    "work_thread_id": {
      "type": "string",
      "pattern": "^wth_[0-9a-f]{32}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "object_format": { "const": "sha1" } },
        "required": ["object_format"]
      },
      "then": {
        "properties": {
          "expected_base_revision": { "pattern": "^[0-9a-f]{40}$" },
          "head_revision": { "pattern": "^[0-9a-f]{40}$" },
          "tree_revision": { "pattern": "^[0-9a-f]{40}$" }
        }
      },
      "else": {
        "properties": {
          "expected_base_revision": { "pattern": "^[0-9a-f]{64}$" },
          "head_revision": { "pattern": "^[0-9a-f]{64}$" },
          "tree_revision": { "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  ],
  "$defs": {
    "objectId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_separation", "schema_version", "validations"],
      "properties": {
        "maintainer_approval": { "const": true },
        "review_separation": {
          "type": ["string", "null"],
          "enum": [
            "different_profile",
            "different_identity",
            "different_profile_and_identity",
            null
          ]
        },
        "schema_version": { "const": 1 },
        "validations": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/validation" }
        }
      },
      "anyOf": [
        {
          "properties": { "review_separation": { "type": "string" } },
          "required": ["review_separation"]
        },
        {
          "properties": { "validations": { "minItems": 1 } },
          "required": ["validations"]
        },
        {
          "properties": { "maintainer_approval": { "const": true } },
          "required": ["maintainer_approval"]
        }
      ]
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "image_id", "name"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\u0000]+$"
          }
        },
        "image_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magic-glass-box:schema:maintainer-review-request:v1",
  "title": "Magic Glass Box Maintainer Review Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "details", "schema_version", "summary"],
  "properties": {
    "decision": { "enum": ["approved", "changes_requested"] },
    "details": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "schema_version": { "const": 1 },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "decision": { "const": "changes_requested" } },
        "required": ["decision"]
      },
      "then": {
        "properties": { "details": { "minItems": 1 } }
      }
    }
  ]
}

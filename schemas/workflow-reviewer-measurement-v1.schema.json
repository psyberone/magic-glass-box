{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magic-glass-box:schema:workflow-reviewer-measurement:v1",
  "title": "Magic Glass Box Reviewer Measurement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "architecture",
    "attempt_id",
    "code_origin",
    "code_origin_sha256",
    "collected_count",
    "command",
    "comparison_rules",
    "duration_ms",
    "executed_count",
    "exit_code",
    "inputs",
    "interpreter",
    "name",
    "output_bytes",
    "output_sha256",
    "result_field_semantics",
    "schema_version",
    "tool_observations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "inputs": { "$ref": "#/$defs/inputs" },
    "attempt_id": { "type": "string", "pattern": "^att_[0-9a-f]{32}$" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "x-max-utf8-bytes": 1024 }
    },
    "architecture": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "code_origin": {
      "type": "string",
      "minLength": 1,
      "x-max-utf8-bytes": 1024
    },
    "code_origin_sha256": { "$ref": "#/$defs/sha256" },
    "interpreter": {
      "type": "string",
      "minLength": 1,
      "x-max-utf8-bytes": 256
    },
    "tool_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/toolObservation" },
      "contains": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "const": "present" } }
      },
      "minContains": 1
    },
    "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
    "duration_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
    "collected_count": { "type": "integer", "minimum": 1, "maximum": 10000000 },
    "executed_count": { "type": "integer", "minimum": 1, "maximum": 10000000 },
    "output_sha256": { "$ref": "#/$defs/sha256" },
    "output_bytes": { "type": "integer", "minimum": 0, "maximum": 25165824 },
    "result_field_semantics": { "$ref": "#/$defs/resultFieldSemantics" },
    "comparison_rules": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "x-max-utf8-bytes": 1024 }
    }
  },
  "$defs": {
    "toolObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
        },
        "status": { "enum": ["present", "absent"] },
        "version": { "type": ["string", "null"], "x-max-utf8-bytes": 256 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "present" } } },
          "then": { "properties": { "version": { "type": "string", "minLength": 1 } } },
          "else": { "properties": { "version": { "type": "null" } } }
        }
      ]
    },
    "resultFieldSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collected_count", "executed_count", "exit_code", "output_sha256"
      ],
      "properties": {
        "collected_count": {
          "type": "string", "minLength": 1, "x-max-utf8-bytes": 1024
        },
        "executed_count": {
          "type": "string", "minLength": 1, "x-max-utf8-bytes": 1024
        },
        "exit_code": {
          "type": "string", "minLength": 1, "x-max-utf8-bytes": 1024
        },
        "output_sha256": {
          "type": "string", "minLength": 1, "x-max-utf8-bytes": 1024
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "expected_base_revision",
        "head_revision",
        "integration_ref",
        "object_format",
        "policy_id",
        "policy_revision",
        "repository_identity",
        "tree_revision"
      ],
      "properties": {
        "candidate_id": { "type": "string", "pattern": "^cnd_[0-9a-f]{32}$" },
        "expected_base_revision": { "$ref": "#/$defs/objectId" },
        "head_revision": { "$ref": "#/$defs/objectId" },
        "integration_ref": {
          "type": "string",
          "pattern": "^refs/heads/(?!@$)(?!\\.)(?!.*\\/\\.)(?!.*(?:\\.\\.|@\\{|//|\\.lock(?:/|$)))(?!.*[/.]$)[^ ~^:?*\\\\[\\u0000-\\u001f\\u007f]+$",
          "maxLength": 512
        },
        "object_format": { "enum": ["sha1", "sha256"] },
        "policy_id": { "type": "string", "pattern": "^gpl_[0-9a-f]{32}$" },
        "policy_revision": { "$ref": "#/$defs/sha256" },
        "repository_identity": { "type": "string", "pattern": "^boxp_[0-9a-f]{32}$" },
        "tree_revision": { "$ref": "#/$defs/objectId" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "object_format": { "const": "sha1" } },
            "required": ["object_format"]
          },
          "then": {
            "properties": {
              "expected_base_revision": { "pattern": "^[0-9a-f]{40}$" },
              "head_revision": { "pattern": "^[0-9a-f]{40}$" },
              "tree_revision": { "pattern": "^[0-9a-f]{40}$" }
            }
          },
          "else": {
            "properties": {
              "expected_base_revision": { "pattern": "^[0-9a-f]{64}$" },
              "head_revision": { "pattern": "^[0-9a-f]{64}$" },
              "tree_revision": { "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      ]
    },
    "objectId": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

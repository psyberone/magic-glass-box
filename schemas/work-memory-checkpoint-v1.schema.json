{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magic-glass-box:schema:work-memory-checkpoint:v1",
  "title": "Magic Glass Box work-memory checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "summary",
    "decisions",
    "artifacts",
    "next_steps",
    "open_blockers",
    "candidate_revision"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
    "decisions": {"$ref": "#/$defs/notes"},
    "artifacts": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "next_steps": {"$ref": "#/$defs/notes"},
    "open_blockers": {"$ref": "#/$defs/notes"},
    "candidate_revision": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 512}
      ]
    }
  },
  "$defs": {
    "notes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "description"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\).+$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    }
  }
}

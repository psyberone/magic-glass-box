{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magic-glass-box:schema:service-operation:v1",
  "title": "Magic Glass Box Service Operation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "connector_name",
    "deployment_sha256",
    "idempotency_key",
    "mapping",
    "parameters",
    "request_bytes",
    "response_bytes",
    "schema_version",
    "target",
    "timeout_ms"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "connector_name": { "$ref": "#/$defs/name" },
    "deployment_sha256": { "$ref": "#/$defs/sha256" },
    "mapping": { "$ref": "#/$defs/mapping" },
    "capability": { "$ref": "#/$defs/capability" },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "target": { "$ref": "#/$defs/target" },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": [
            "access_token",
            "accessToken",
            "api_key",
            "apiKey",
            "api_token",
            "apiToken",
            "authorization",
            "bearer_token",
            "bearerToken",
            "credential",
            "credential-ref",
            "credential_ref",
            "credentialRef",
            "credentials",
            "password",
            "private_key",
            "privateKey",
            "refresh_token",
            "refreshToken",
            "secret",
            "token"
          ]
        }
      }
    },
    "request_bytes": { "type": "integer", "minimum": 1, "maximum": 2097152 },
    "response_bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
    "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 120000 }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "name", "version"],
      "properties": {
        "mode": { "enum": ["read", "effect"] },
        "name": {
          "type": "string",
          "pattern": "^(work|change|checks|refs|landing)\\.[a-z][a-z0-9_-]{0,63}$"
        },
        "version": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "name": { "const": "change.open" },
              "version": { "const": 1 }
            },
            "required": ["name", "version"]
          },
          "then": { "properties": { "mode": { "const": "effect" } } }
        },
        {
          "if": {
            "properties": {
              "name": { "const": "checks.read" },
              "version": { "const": 1 }
            },
            "required": ["name", "version"]
          },
          "then": { "properties": { "mode": { "const": "read" } } }
        },
        {
          "if": {
            "properties": {
              "name": { "const": "landing.invoke" },
              "version": { "const": 1 }
            },
            "required": ["name", "version"]
          },
          "then": { "properties": { "mode": { "const": "effect" } } }
        }
      ]
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account",
        "credential_scope_sha256",
        "host",
        "name",
        "repository",
        "service"
      ],
      "properties": {
        "account": { "$ref": "#/$defs/text256" },
        "credential_scope_sha256": { "$ref": "#/$defs/sha256" },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/@?#\\u0000-\\u001f\\u007f]+$"
        },
        "name": { "$ref": "#/$defs/name" },
        "repository": { "$ref": "#/$defs/repository" },
        "service": { "$ref": "#/$defs/name" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desired_revision",
        "expected_revision",
        "object_format",
        "repository",
        "resource_id"
      ],
      "properties": {
        "repository": { "$ref": "#/$defs/repository" },
        "resource_id": { "$ref": "#/$defs/text512" },
        "object_format": { "enum": [null, "sha1", "sha256"] },
        "expected_revision": {
          "type": ["string", "null"],
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "desired_revision": {
          "type": ["string", "null"],
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "object_format": { "const": null } } },
          "then": {
            "properties": {
              "expected_revision": { "const": null },
              "desired_revision": { "const": null }
            }
          }
        },
        {
          "if": { "properties": { "object_format": { "const": "sha1" } } },
          "then": {
            "properties": {
              "expected_revision": {
                "type": ["string", "null"],
                "pattern": "^[0-9a-f]{40}$"
              },
              "desired_revision": {
                "type": ["string", "null"],
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": { "properties": { "object_format": { "const": "sha256" } } },
          "then": {
            "properties": {
              "expected_revision": {
                "type": ["string", "null"],
                "pattern": "^[0-9a-f]{64}$"
              },
              "desired_revision": {
                "type": ["string", "null"],
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "text256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": ".*\\S.*"
    },
    "text512": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": ".*\\S.*"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?=.*\\S)[^:@?#\\u0000-\\u001f\\u007f]+$"
    }
  }
}

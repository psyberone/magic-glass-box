{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magic-glass-box:schema:inference-connector:v1",
  "title": "Magic Glass Box Inference Connector v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connector_protocol_version",
    "deployment_sha256",
    "max_concurrency",
    "request_bytes",
    "response_bytes",
    "routes",
    "schema_version",
    "timeout_ms",
    "transport"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "connector_protocol_version": { "const": 1 },
    "deployment_sha256": { "$ref": "#/$defs/sha256" },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "socket_path"],
      "properties": {
        "kind": { "const": "unix" },
        "socket_path": {
          "type": "string",
          "pattern": "^/[^\\u0000-\\u001f\\u007f]*$",
          "maxLength": 100
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/route" }
    },
    "request_bytes": { "type": "integer", "minimum": 1, "maximum": 2097152 },
    "response_bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
    "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 120000 },
    "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 16 }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_scope_sha256",
        "models",
        "name",
        "protocol",
        "provider"
      ],
      "properties": {
        "credential_scope_sha256": { "$ref": "#/$defs/sha256" },
        "models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": ".*\\S.*"
          }
        },
        "name": { "$ref": "#/$defs/name" },
        "protocol": { "$ref": "#/$defs/name" },
        "provider": { "$ref": "#/$defs/name" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magic-glass-box:schema:landing-readback:v1",
  "title": "Magic Glass Box Landing Readback v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_ref", "candidate_revision", "change_id", "landing_revision",
    "landing_revision_reachable", "landing_tree", "merge_method", "primary_ref",
    "primary_revision", "schema_version", "secondary_effects"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "change_id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "base_ref": { "$ref": "#/$defs/branchRef" },
    "candidate_revision": { "$ref": "#/$defs/objectId" },
    "landing_revision": { "$ref": "#/$defs/objectId" },
    "landing_tree": { "$ref": "#/$defs/objectId" },
    "primary_ref": { "$ref": "#/$defs/branchRef" },
    "primary_revision": { "$ref": "#/$defs/objectId" },
    "landing_revision_reachable": { "type": "boolean" },
    "merge_method": { "enum": ["merge", "rebase", "squash"] },
    "secondary_effects": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "branchRef": { "type": "string", "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9._/-]{0,254}$" },
    "objectId": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }
  }
}

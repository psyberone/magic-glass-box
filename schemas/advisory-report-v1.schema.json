{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magic-glass-box.local/schemas/advisory-report-v1.schema.json",
  "title": "Magic Glass Box triangulated advisory report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "attention",
    "summary",
    "items",
    "follow_up_checks"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "authority": {"const": "advisory_only"},
    "attention": {"enum": ["none", "routine", "urgent"]},
    "summary": {"$ref": "#/$defs/text4096"},
    "items": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/item"}
    },
    "follow_up_checks": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text2048"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"attention": {"const": "none"}}},
      "then": {"properties": {"items": {"maxItems": 0}}},
      "else": {"properties": {"items": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
    "text2048": {"type": "string", "minLength": 1, "maxLength": 2048},
    "text4096": {"type": "string", "minLength": 1, "maxLength": 4096},
    "reviewerRole": {
      "enum": ["reviewer_one", "reviewer_two", "reviewer_three"]
    },
    "findingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_role", "finding_key"],
      "properties": {
        "reviewer_role": {"$ref": "#/$defs/reviewerRole"},
        "finding_key": {"$ref": "#/$defs/key"}
      }
    },
    "challengeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_role", "challenge_key"],
      "properties": {
        "reviewer_role": {"$ref": "#/$defs/reviewerRole"},
        "challenge_key": {"$ref": "#/$defs/key"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "classification",
        "severity",
        "summary",
        "finding_refs",
        "challenge_refs",
        "recommended_action"
      ],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "classification": {
          "enum": ["corroborated", "contested", "singleton", "dismissed"]
        },
        "severity": {"enum": ["critical", "major", "minor", "note"]},
        "summary": {"$ref": "#/$defs/text4096"},
        "finding_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/findingRef"}
        },
        "challenge_refs": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/challengeRef"}
        },
        "recommended_action": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/text4096"}]
        }
      }
    }
  }
}

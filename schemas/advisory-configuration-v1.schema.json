{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magic-glass-box.local/schemas/advisory-configuration-v1.schema.json",
  "title": "Magic Glass Box advisory review configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "max_findings_per_reviewer",
    "max_challenges_per_reviewer",
    "max_report_items"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "max_findings_per_reviewer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "max_challenges_per_reviewer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "max_report_items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magic-glass-box:schema:work-item-list-result:v1",
  "title": "Magic Glass Box Work Item List Result v1",
  "description": "One bounded provider-neutral discovery window. Provider cursors, status names, queries, and descriptions are excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "schema_version", "truncated"],
  "properties": {
    "schema_version": { "const": 1 },
    "items": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reference" }
    },
    "truncated": { "type": "boolean" }
  },
  "$defs": {
    "nonblank512": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignees",
        "external_id",
        "labels",
        "object_id",
        "source_updated_at",
        "title"
      ],
      "properties": {
        "object_id": { "$ref": "#/$defs/nonblank512" },
        "external_id": { "$ref": "#/$defs/nonblank512" },
        "source_updated_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "pattern": "T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "title": { "$ref": "#/$defs/nonblank512" },
        "assignees": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        },
        "labels": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
